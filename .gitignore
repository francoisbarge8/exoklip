# --- Project specific -------------------------------------------------------
# Smoke-test figures written by the plotting self-checks: throwaway.
examples/output/_smoke/

# Science data is never committed: FITS cubes are hundreds of MB and are not
# ours to redistribute. Fetch them from the Keck Observatory Archive instead
# (see the "Real data" section of the README).
*.fits
*.fits.gz
*.fit
data/
raw/

# Simulated datasets written by `python -m exoklip simulate` — regenerate them
# from the seed rather than committing them.
*.npy
*.npz

# The reference demo figures under examples/output/ ARE committed on purpose:
# they are what the README shows. Keep them small.
